[Unit]
Description=Porkbun dynamic DNS updater
Documentation=https://porkbun.com/api/json/v3/documentation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/porkbun-ud --config /etc/porkbun-ud/config.toml
EnvironmentFile=/etc/porkbun-ud/credentials.env

DynamicUser=yes
StateDirectory=porkbun-ud
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
